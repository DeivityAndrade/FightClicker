	"random": {
		"fields": ["skin", "hair_color", "hair_style", "shorts_color", "top", "top_color", "headband", "headband_color", "socks"],
		"_doc_weight": "Cada opção sorteia com peso `weight` (ausente = 1) entre as ligadas.",
		"avoid_same_shorts_as_last": true,
		"avoid_same_hair_as_last": true,
		"max_rerolls": 8,
		"_doc_avoid_pairs": "Depois de sortear tudo: se o look bate com um par (if E and), sorteia de novo o campo `reroll` (até max_rerolls; se não resolver, fica). Só vale para o sorteio; a escolha na tela é livre.",
		"avoid_pairs": [
			{ "if": { "hair_color": "black" },      "and": { "headband_color": "black" },  "reroll": "headband_color" },
			{ "if": { "hair_color": "dark_brown" }, "and": { "headband_color": "black" },  "reroll": "headband_color" },
			{ "if": { "hair_color": "blond" },      "and": { "headband_color": "yellow" }, "reroll": "headband_color" },
			{ "if": { "hair_color": "copper" },     "and": { "headband_color": "yellow" }, "reroll": "headband_color" },
			{ "if": { "hair_color": "platinum" },   "and": { "headband_color": "white" },  "reroll": "headband_color" },
			{ "if": { "skin": "skin_5" },           "and": { "top_color": "black" },       "reroll": "top_color" },
			{ "if": { "shorts_color": "white" },    "and": { "top_color": "white" },       "reroll": "top_color" },
			{ "if": { "shorts_color": "yellow" },   "and": { "top_color": "yellow" },      "reroll": "top_color" }
		]
	},

	"screen": {
		"_doc": "Linhas da tela de criação (6b2), na ordem. Coluna 1 = cabeça, coluna 2 = corpo. kind colors = chips de cor; kind text = nome da opção (ui_texts disc_opt_<campo>_<id>). depends_on: com o campo pai em none a linha fica apagada e a seta não faz nada (o valor fica guardado).",
		"rows_per_column": 6,
		"rows": [
			{ "field": "name",           "label": "disc_label_name" },
			{ "field": "skin",           "label": "disc_label_skin",       "kind": "colors", "chips": 3 },
			{ "field": "hair_style",     "label": "disc_label_style",      "kind": "text" },
			{ "field": "hair_color",     "label": "disc_label_hair",       "kind": "colors", "chips": 2 },
			{ "field": "headband",       "label": "disc_label_band",       "kind": "text" },
			{ "field": "headband_color", "label": "disc_label_band_color", "kind": "colors", "chips": 2, "depends_on": "headband" },
			{ "field": "top",            "label": "disc_label_top",        "kind": "text" },
			{ "field": "top_color",      "label": "disc_label_top_color",  "kind": "colors", "chips": 3, "depends_on": "top" },
			{ "field": "shorts_color",   "label": "disc_label_shorts",     "kind": "colors", "chips": 3 },
			{ "field": "socks",          "label": "disc_label_socks",      "kind": "text" }
		]
	},

