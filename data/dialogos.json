		"coach": { "base_hz": 110, "cps": 22, "vowel_order": "uoaei", "vowel_steps": [0, 2, 4, 5, 7] },
		"disciple": { "base_hz": 260, "cps": 30, "vowel_order": "uoaei", "vowel_steps": [0, 2, 4, 5, 7] }
